# Repick — environment template
# Copy this file to `.env` and fill in your Supabase credentials, then restart `npm run dev`.
#
#   cp .env.example .env
#
# Where to find them: Supabase Dashboard → your project → Project Settings → API
#   - Project URL      → NEXT_PUBLIC_SUPABASE_URL
#   - anon / publishable key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# The `NEXT_PUBLIC_` prefix is supported on purpose (Vite is configured with
# envPrefix ["VITE_", "NEXT_PUBLIC_"]), so values copied straight from the
# Supabase dashboard just work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
